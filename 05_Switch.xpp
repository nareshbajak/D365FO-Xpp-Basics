class Switch{

    public static void main(Args_args){

        day = 2;

        Switch(day){

            case 1:
                info("Monday");
                break;
            case 2:
                info("Tuesday");
                break;
            case 3:
                info("Wednesday");
                break;
            default:
                inf("Invalid Day");
                break;
        }
    }
}
